BOT_TOKEN=
# At least one LLM key is required (tried in LLM_ORDER). Groq is fastest/cheapest.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

LLM_ORDER=groq,gemini,openai

DATABASE_URL=sqlite+aiosqlite:///./data.db
# Example Postgres: postgresql+asyncpg://bot:bot@postgres:5432/sayitbetter
REDIS_URL=
ADMIN_IDS=
FREE_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=500
DEFAULT_LANGUAGE=ru
LOG_LEVEL=INFO

# Optional webhook mode (instead of polling) — needs a public HTTPS endpoint.
# WEBHOOK_URL=https://your-domain.example/webhook
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=
# WEBHOOK_PORT=8080
